# URL base del WordPress headless (cms.itacarb.es)
WORDPRESS_URL=https://cms.itacarb.es

# Pre-auditoría (lead magnet)
# ID numérico de la lista It_leadmagnets de Brevo (los contactos se guardan ahí).
BREVO_LEADMAGNETS_LIST_ID=27
# A dónde llega el aviso con cada solicitud (por defecto hola@itacarb.es).
PRE_AUDITORIA_NOTIFY_EMAIL=
# URL para reservar llamada en la página de gracias. Vacía = no se muestra el CTA.
NEXT_PUBLIC_BOOKING_URL=
